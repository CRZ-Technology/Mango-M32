FIL MyFile;     /* File object */

void SDMMC_Initialization(void)
{
    /*##-1- Link the micro SD disk I/O driver ##################################*/
    if(FATFS_LinkDriver(&SD_Driver, SDPath) != 0)
    {
        printf("Error FATFS_LinkDriver !!\r\n");
        return;
    }
    printf("FATFS_LinkDriver OK\r\n");

    /*##-2- Register the file system object to the FatFs module ##############*/
    if(f_mount(&SDFatFs, (TCHAR const*)SDPath, 0) != FR_OK)
    {
    	printf("Error f_mount !!\r\n");
        return;
    }
    printf("f_mount OK\r\n");
}

int SDMMC_Format(void)
{
    /* ## Create a FAT file system (format) on the logical drive ######### */
    /* WARNING: Formatting the uSD card will delete all content on the device */
    if(f_mkfs((TCHAR const*)SDPath, 0, 0, 0, 0) == FR_OK)
    {
        printf("SDMMC Card Format OK\r\n");
        return 0;
    }
    else
    {
    	printf("Error FatFs Format Error !!\r\n");
        return -1;
    }
}

void SDMMC_Test(void)
{
    FRESULT res;                                          /* FatFs function common result code */
    uint32_t byteswritten, bytesread;                     /* File write/read counts */
    uint8_t wtext[] = "This is STM32 working with FatFs"; /* File write buffer */
    uint8_t rtext[100];                                   /* File read buffer */
    uint8_t retVal;

    /* Initialize SDMMC */
    SDMMC_Initialization();

    retVal = BSP_SD_Init();
    if(MSD_OK != retVal)
    {
        HAL_Delay(10);

        printf("BSP_SD_Init retry\r\n");
        retVal = BSP_SD_Init();
        if(MSD_OK != retVal)
        {
        	printf("Error BSP_SD_Init !!\r\n");
            return;
        }
    }
    printf("BSP_SD_Init OK\r\n");

    if(SDMMC_Format() < 0)
    {
    	printf("Error Format !!\r\n");
        return;
    }
    printf("Format OK\r\n");

    /*##-4- Create and Open a new text file object with write access #####*/
    if(f_open(&MyFile, "STM32.TXT", FA_CREATE_ALWAYS | FA_WRITE) != FR_OK)
    {
        /* 'STM32.TXT' file Open for write Error */
    	printf("Error STM32.TXT file Open for write !!\r\n");
        return;
    }
    printf("f_open STM32.TXT OK\r\n");

    /*##-5- Write data to the text file ################################*/
    res = f_write(&MyFile, wtext, sizeof(wtext), (void *)&byteswritten);

    /*##-6- Close the open text file #################################*/
    if (f_close(&MyFile) != FR_OK )
    {
    	printf("Error STM32.TXT file close !!\r\n");
        return;
    }
    printf("f_close STM32.TXT OK\r\n");

    if((byteswritten == 0) || (res != FR_OK))
    {
        /* 'STM32.TXT' file Write or EOF Error */
    	printf("Error STM32.TXT file Write or EOF Error !!\r\n");
        return;
    }

    printf("STM32.TXT file Write OK\r\n");

    /*##-7- Open the text file object with read access ###############*/
    if(f_open(&MyFile, "STM32.TXT", FA_READ) != FR_OK)
    {
        /* 'STM32.TXT' file Open for read Error */
    	printf("Error STM32.TXT file Open for read Error !!\r\n");
        return;
    }
    printf("f_open STM32.TXT OK\r\n");

    /*##-8- Read data from the text file ###########################*/
    res = f_read(&MyFile, rtext, sizeof(rtext), (UINT*)&bytesread);

    if((bytesread == 0) || (res != FR_OK))
    {
        /* 'STM32.TXT' file Read or EOF Error */
    	printf("Error STM32.TXT file Read or EOF Error !!\r\n");
        return;
    }
    printf("f_read STM32.TXT OK\r\n");

    /*##-9- Close the open text file #############################*/
    f_close(&MyFile);

    /*##-10- Compare read data with the expected data ############*/
    if((bytesread != byteswritten))
    {
        /* Read data is different from the expected data */
    	printf("Error Read data is different from the expected data !!\r\n");
        return;
    }
}
