extern struct netif gnetif;
void poll_dhcp_and_print_once(void)
{
    static uint8_t printed = 0;

    struct dhcp *d = netif_dhcp_data(&gnetif);
    if (!d) return;

    if (!printed && d->state == DHCP_STATE_BOUND)
    {
        printf("DHCP BOUND!\r\n");
        printf("IP: %s\r\n", ip4addr_ntoa(netif_ip4_addr(&gnetif)));
        printf("GW: %s\r\n", ip4addr_ntoa(netif_ip4_gw(&gnetif)));
        printf("MSK: %s\r\n", ip4addr_ntoa(netif_ip4_netmask(&gnetif)));
        printed = 1;
    }
}

